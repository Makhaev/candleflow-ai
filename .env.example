# Local development defaults for the demonstration. Keep real credentials out of Git.
# Compose uses internal service addresses for PostgreSQL, Redis and the two mocks.
# For a new PostgreSQL 16 volume, set POSTGRES_IMAGE=postgres:16-alpine.
POSTGRES_IMAGE=postgres:17-alpine
DATABASE_URL=postgresql+psycopg://candleflow:candleflow@localhost:5432/candleflow
REDIS_URL=redis://localhost:6379/0
RATES_URL=http://localhost:8003
MARKING_URL=http://localhost:8001

AI_PROVIDER=fake
OPENAI_API_KEY=
PRIMARY_MODEL=gpt-5.4-mini
FALLBACK_MODEL=gpt-6-luna
LLM_TIMEOUT=45

# Export the following optional variables in your shell for the relevant command.
# The test and eval runners require separate PostgreSQL databases.
# TEST_DATABASE_URL=
# EVAL_DATABASE_URL=
# CANDLEFLOW_API_PROXY=http://localhost:8000
